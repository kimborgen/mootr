#!/bin/sh
# Entry point for the stam CLI, daemon, hooks, and MCP shim.
here=$(dirname "$(readlink -f "$0")")
# Hooks and the status line run on every tool call and every refresh, so they take the
# shell fast path (bin/stam-fast), which never starts node.
case "${1:-}" in
  hook | statusline) exec "$here/stam-fast" "$@" ;;
esac
# The broad-kill guard (a PreToolUse hook) imports only its own module, so it starts fast.
case "${1:-}" in
  guard) exec node --no-warnings "$here/../src/guard-hook.ts" ;;
esac
exec node --no-warnings "$here/../src/cli.ts" "$@"
