#!/bin/sh
# The cheap path for `stam hook` and `stam statusline`. Both run on every tool call and
# every Claude Code status-line refresh, and starting node (TypeScript stripping plus the
# whole CLI import graph) costs about 230 ms of CPU a call; under 20+ agents that is what
# pushed the load. This does the same work in the shell: read the payload, POST it to the
# daemon, print what it answers, and run the user's own status line. bin/stam sends the two
# commands here, and this falls back to the node CLI (src/cli.ts) when curl, a JSON parser,
# or `timeout` is missing. The output and the hook's semantics are the node path's, byte
# for byte.
here=$(dirname "$(readlink -f "$0")")
node_cli() { exec node --no-warnings "$here/../src/cli.ts" "$@"; }

cmd=${1:-}
harness=${2:-}
[ -n "$harness" ] || node_cli "$@"
command -v curl >/dev/null 2>&1 || node_cli "$@"
# The status line forwards to the user's own command behind `timeout`; the hook prints the
# daemon's JSON notice, so it needs jq or python3 to unescape it.
if [ "$cmd" = statusline ]; then
  command -v timeout >/dev/null 2>&1 || node_cli "$@"
else
  command -v jq >/dev/null 2>&1 || command -v python3 >/dev/null 2>&1 || node_cli "$@"
fi

url=${MOOTR_URL:-${STAM_URL:-http://127.0.0.1:${MOOTR_PORT:-${STAM_PORT:-7878}}}}
# env MOOTR_TOKEN (or STAM_TOKEN) wins, then the daemon's token file, as src/config.ts readToken does.
# The home is the MOOTR_HOME or STAM_HOME override, else the default_home rule: a real stam folder, else mootr.
# A home that can't be inspected falls to the node CLI, which reports it.
home=${MOOTR_HOME:-${STAM_HOME:-}}
if [ -z "$home" ]; then
  # dash exits on a `.` of a missing file even behind `||`, so the file is tested first.
  [ -r "$here/../scripts/default-home.sh" ] || node_cli "$@"
  . "$here/../scripts/default-home.sh"
  home=$(default_home 2>/dev/null) || node_cli "$@"
fi
token=${MOOTR_TOKEN:-${STAM_TOKEN:-$(cat "$home/token" 2>/dev/null)}}
id=${MOOTR_AGENT_ID:-${STAM_AGENT_ID:-}}
usl=${MOOTR_USER_STATUSLINE:-${STAM_USER_STATUSLINE:-}}

# The exact payload, kept in a stam-hook.* file (the prefix names a leftover from a hook killed
# hard, where no trap runs; S-668): the daemon's route reads a JSON body, and a tool-call
# hook's can exceed the 128 KB limit on one argument.
in=$(mktemp "${TMPDIR:-/tmp}/stam-hook.XXXXXX") || node_cli "$@"
printed=
trap 'rm -f "$in" "$printed"' EXIT
trap 'exit 0' INT TERM HUP
cat >"$in"

case "$cmd" in
hook)
  # A hook must never block or fail the agent: every failure exits 0 with no output.
  # While the daemon is down (a deploy restarts it) the POST retries for up to 30 s, as the
  # node path does: a lost Stop left an idle agent 'working' for hours (S-188). Only a refused
  # connection (curl exit 7) retries; a timeout may mean the daemon took the event.
  [ -n "$id" ] || exit 0
  tries=0
  while :; do
    resp=$(curl -sS -m 3 -X POST -H "authorization: Bearer $token" -H 'content-type: application/json' \
      --data-binary @"$in" "$url/api/hook/$harness/$id" 2>/dev/null) && break
    [ $? -eq 7 ] && [ $tries -lt 60 ] || { resp=; break; }
    tries=$((tries + 1))
    sleep 0.5
  done
  [ -n "$resp" ] || exit 0
  # Exactly the node path's `process.stdout.write(r.stdout)`, trailing newline included: the text goes through a file,
  # so the exit status of each step can be checked. jq's --join-output adds none, and `cat` writes the bytes out as they
  # are, where a command substitution would strip a newline.
  printf '%s' "$resp" >"$in" || exit 0
  # The printed text holds the notices, so it lives in a private file (mktemp: mode 0600, and a stam-hook.* name the
  # janitor sweeps), removed on exit.
  printed=$(mktemp "${TMPDIR:-/tmp}/stam-hook.XXXXXX") || exit 0
  if command -v jq >/dev/null 2>&1; then
    jq --join-output '.stdout // empty' "$in" >"$printed" 2>/dev/null || exit 0
    acks=$(jq -r '.ack[]?' "$in" 2>/dev/null)
  else
    python3 -c 'import json, sys
d = json.load(open(sys.argv[1]))
out = d.get("stdout") if isinstance(d, dict) else None
sys.stdout.write(out or "")' "$in" >"$printed" 2>/dev/null || exit 0
    acks=$(python3 -c 'import json, sys
d = json.load(open(sys.argv[1]))
[print(r) for r in (d.get("ack") or []) if isinstance(d, dict)]' "$in" 2>/dev/null)
  fi
  # Only a response that was printed in full reached the agent, so only then may the daemon delete the answer rows
  # the response carried (S-3923). A closed or full stdout fails the write and sends no ack. A failed acknowledgement
  # keeps the rows, and a restart replays them.
  cat "$printed" || exit 0
  for row in $acks; do
    curl -sS -m 3 -X POST -H "authorization: Bearer $token" "$url/api/notices/$id/ack/$row" >/dev/null 2>&1
  done
  exit 0
  ;;
statusline)
  # A 1 s report, then the user's own status line, from the same payload. Its output is
  # written straight through, so its bytes (a trailing newline included) are unchanged.
  # The daemon answers {"viewed":true|false}; no answer keeps the 30 s cache (S-274).
  ttl=30
  unviewed=0
  reply=
  [ -n "$id" ] && reply=$(curl -s -m 1 -X POST -H "authorization: Bearer $token" -H 'content-type: application/json' \
    --data-binary @"$in" "$url/api/statusline/$harness/$id" 2>/dev/null)
  case "$reply" in *'"viewed":false'*) unviewed=1 ;; esac
  printf '%s' "[stam ${id:-?}] "
  # The user's status line runs at most once per ttl per agent (30 s; src/statusline-cache.ts,
  # S-171, S-274). An agent nobody views never runs again once it has saved output (S-1055), and
  # a refresh inside the ttl prints the saved output: the file's first line is the time.
  if [ -n "$usl" ]; then
    cache="$home/statusline-$id.out"
    now=$(date +%s)
    at=$(head -n 1 "$cache" 2>/dev/null)
    case "$at" in ''|*[!0-9]*) at= ;; esac
    if [ -n "$id" ] && [ -n "$at" ] && [ $((now - at)) -ge 0 ] && { [ $unviewed = 1 ] || [ $((now - at)) -lt $ttl ]; }; then
      tail -n +2 "$cache"
    else
      # printf x keeps the output's trailing newlines through the command substitution.
      out=$(timeout 5 sh -c "$usl" <"$in" 2>/dev/null; printf x)
      out=${out%x}
      if [ -n "$id" ]; then
        mkdir -p "${cache%/*}" && printf '%s\n%s' "$now" "$out" >"$cache.tmp" && mv "$cache.tmp" "$cache"
      fi
      printf '%s' "$out"
    fi
  fi
  exit 0
  ;;
esac
rm -f "$in"
node_cli "$@"
