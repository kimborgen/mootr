{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stam/processes/schema.json",
  "title": "stam process file",
  "description": "The shape of one processes/<id>.yaml. This checks the file's shape; src/process.ts checks the cross-references (lane names, edge targets, call targets, ITSA statuses) the schema can't.",
  "type": "object",
  "required": ["process", "title", "lanes", "nodes", "edges"],
  "additionalProperties": false,
  "properties": {
    "process": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "applies_to": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "kind": { "type": "array", "items": { "type": "string" } } }
    },
    "lanes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/lane" }
    },
    "nodes": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z][a-z0-9_-]*$" },
      "additionalProperties": { "$ref": "#/$defs/node" }
    },
    "edges": { "type": "array", "items": { "$ref": "#/$defs/edge" } }
  },
  "$defs": {
    "lane": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "label": { "type": "string" },
        "fallback": { "type": "string" }
      }
    },
    "node": {
      "type": "object",
      "required": ["kind", "lane"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["start", "end", "agent", "human", "script", "exclusive", "parallel", "wait"] },
        "lane": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
        "label": { "type": "string" },
        "statuses": { "type": "array", "items": { "type": "string" } },
        "done_when": { "type": "string" },
        "brief": { "type": "string" },
        "tell": {
          "type": "object",
          "required": ["lanes", "text"],
          "additionalProperties": false,
          "properties": {
            "lanes": { "type": "array", "minItems": 1, "items": { "type": "string" } },
            "text": { "type": "string", "minLength": 1 }
          }
        },
        "ask": { "enum": ["approve", "decide", "answer", "review", "test"] },
        "run": { "type": "string" },
        "event": { "type": "string" },
        "status": { "enum": ["done", "canceled", "wont_do"] },
        "call": { "type": "string" },
        "boundary": { "type": "array", "items": { "$ref": "#/$defs/boundary" } },
        "triggers": { "type": "array", "items": { "$ref": "#/$defs/trigger" } }
      }
    },
    "boundary": {
      "type": "object",
      "required": ["on"],
      "additionalProperties": false,
      "properties": {
        "on": { "enum": ["cost", "timeout", "error"] },
        "action": { "type": "string" },
        "minutes": { "type": "number" },
        "interrupting": { "type": "boolean" }
      }
    },
    "trigger": {
      "type": "object",
      "required": ["source"],
      "additionalProperties": false,
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "label": { "type": "string" },
        "subjects": { "type": "array", "items": { "type": "string" } },
        "types": { "type": "array", "items": { "type": "string" } },
        "actors": { "type": "array", "items": { "type": "string" } },
        "cron": { "type": "string" }
      }
    },
    "edge": {
      "type": "array",
      "minItems": 2,
      "maxItems": 3,
      "prefixItems": [
        { "type": "string" },
        { "type": "string" },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": { "when": { "type": "string" }, "label": { "type": "string" } }
        }
      ],
      "items": false
    }
  }
}
